<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Cross-platform utility engine shared by KillerTools and KillerMCP.</Description>
    <Version>0.2.1</Version>
    <PackageId>KillerTools.Engine</PackageId>
    <Authors>Steve the Killer</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SteveTheKiller/KillerTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SteveTheKiller/KillerTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Data\*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CronExpressionDescriptor" Version="2.51.0" />
    <PackageReference Include="Jint" Version="4.16.4" />
    <PackageReference Include="libphonenumber-csharp" Version="9.0.40" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Sphere10.HashLib4CSharp" Version="3.1.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
